<Window x:Class="CpuNetWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CPU 网速悬浮窗"
        Width="390" Height="330"
        MinWidth="350" MinHeight="300"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        StateChanged="MainWindow_StateChanged"
        Topmost="True">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="Foreground" Value="#F5F7FA" />
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Background" Value="#273142" />
            <Setter Property="Foreground" Value="#54D6A7" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Window.Resources>

    <Border CornerRadius="16" BorderBrush="#3B465A" BorderThickness="1"
            Background="#F2111827" Padding="17,13,17,15">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.45" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="53" />
                <RowDefinition Height="10" />
                <RowDefinition Height="53" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                    <Ellipse Width="9" Height="9" Fill="#54D6A7" Margin="0,5,9,0" />
                    <TextBlock Text="系统状态" FontSize="14" FontWeight="SemiBold" />
                </StackPanel>
                <Button Grid.Column="1" Width="28" Height="24" Content="—" FontSize="13"
                        Foreground="#B8C2D4" Background="Transparent" BorderThickness="0"
                        Cursor="Hand" ToolTip="最小化到系统托盘" Click="MinimizeToTray_Click" />
                <Button Grid.Column="2" Width="30" Height="24" Content="⚙" FontSize="15"
                        Foreground="#B8C2D4" Background="Transparent" BorderThickness="0"
                        Cursor="Hand" ToolTip="设置与菜单" Click="MenuButton_Click" />
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="CpuPanel" Margin="0,1,15,0">
                    <TextBlock Text="CPU 使用率" FontSize="11" Foreground="#54D6A7" />
                    <TextBlock x:Name="CpuText" Text="--%" Style="{StaticResource MetricValue}" />
                    <ProgressBar x:Name="CpuProgress" Minimum="0" Maximum="100" Value="0" />
                </StackPanel>
                <Border Grid.Column="1" Background="#344056" Margin="0,2,0,5" />
                <StackPanel x:Name="TemperaturePanel" Grid.Column="2" Margin="15,1,0,0">
                    <TextBlock Text="CPU 温度" FontSize="11" Foreground="#FF6B6B" />
                    <TextBlock x:Name="TemperatureText" Text="--°C" Style="{StaticResource MetricValue}" />
                    <TextBlock x:Name="TemperatureHint" Text="正在读取传感器" FontSize="9.5"
                               Foreground="#78859A" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Height="1" Background="#2D384B" VerticalAlignment="Center" />

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="DownloadPanel" Margin="0,4,15,0">
                    <TextBlock Text="↓ 下载" FontSize="11" Foreground="#74B9FF" />
                    <TextBlock x:Name="DownloadText" Text="0 B/s" Style="{StaticResource MetricValue}" />
                </StackPanel>
                <Border Grid.Column="1" Background="#344056" Margin="0,5,0,3" />
                <StackPanel x:Name="UploadPanel" Grid.Column="2" Margin="15,4,0,0">
                    <TextBlock Text="↑ 上传" FontSize="11" Foreground="#FFB86C" />
                    <TextBlock x:Name="UploadText" Text="0 B/s" Style="{StaticResource MetricValue}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="4" Height="1" Background="#2D384B" VerticalAlignment="Center" />

            <Grid Grid.Row="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="25" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <TextBlock x:Name="ChartTitleText" Text="实时曲线 · 最近 1 分钟"
                               FontSize="10.5" Foreground="#8E9AAE" />
                    <TextBlock x:Name="NetworkScaleText" HorizontalAlignment="Right" FontSize="9.5"
                               Foreground="#69768B" Text="网络峰值 --" />
                </Grid>
                <Border Grid.Row="1" CornerRadius="6" Background="#401C2636" ClipToBounds="True">
                    <Grid>
                        <Grid Opacity="0.48">
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="1" BorderBrush="#344056" BorderThickness="0,1,0,0" />
                            <Border Grid.Row="2" BorderBrush="#344056" BorderThickness="0,1,0,0" />
                            <Border Grid.Row="3" BorderBrush="#344056" BorderThickness="0,1,0,0" />
                        </Grid>
                        <Canvas x:Name="ChartCanvas" ClipToBounds="True" SizeChanged="ChartCanvas_SizeChanged">
                            <Polyline x:Name="CpuLine" Stroke="#54D6A7" StrokeThickness="1.8" />
                            <Polyline x:Name="TemperatureLine" Stroke="#FF6B6B" StrokeThickness="1.8" />
                            <Polyline x:Name="DownloadLine" Stroke="#74B9FF" StrokeThickness="1.8" />
                            <Polyline x:Name="UploadLine" Stroke="#FFB86C" StrokeThickness="1.8" />
                        </Canvas>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
