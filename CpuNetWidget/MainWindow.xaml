<Window x:Class="CpuNetWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CPU 网速悬浮窗"
        Width="390" Height="330"
        MinWidth="350" MinHeight="300"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        StateChanged="MainWindow_StateChanged"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        Topmost="True">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="Foreground" Value="#F5F7FA" />
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Background" Value="#273142" />
            <Setter Property="Foreground" Value="#54D6A7" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="TitleButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Foreground" Value="#B8C2D4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" CornerRadius="6" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#344056" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#46536A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
    <Border x:Name="FullPanel" CornerRadius="16" BorderBrush="#3B465A" BorderThickness="1"
            Background="#111827" Padding="17,13,17,15">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.45" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="53" />
                <RowDefinition Height="10" />
                <RowDefinition Height="53" />
                <RowDefinition Height="12" />
                <RowDefinition x:Name="ChartRow" Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                    <Ellipse Width="9" Height="9" Fill="#54D6A7" Margin="0,5,9,0" />
                    <TextBlock Text="系统状态" FontSize="14" FontWeight="SemiBold" />
                </StackPanel>
                <Button Grid.Column="1" Content="◉" FontSize="13" Style="{StaticResource TitleButton}"
                        ToolTip="切换迷你加速球" Click="CompactModeButton_Click" />
                <Button Grid.Column="2" Content="—" FontSize="13" Style="{StaticResource TitleButton}"
                        ToolTip="最小化到系统托盘" Click="MinimizeToTray_Click" />
                <Button Grid.Column="3" Content="⚙" FontSize="15" Style="{StaticResource TitleButton}"
                        ToolTip="打开设置" Click="SettingsButton_Click" />
                <Button Grid.Column="4" Content="×" FontSize="17" Foreground="#FF8A8A"
                        Style="{StaticResource TitleButton}" ToolTip="退出程序" Click="ExitButton_Click" />
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="CpuPanel" Margin="0,1,15,0">
                    <TextBlock Text="CPU 使用率" FontSize="11" Foreground="#54D6A7" />
                    <TextBlock x:Name="CpuText" Text="--%" Style="{StaticResource MetricValue}" />
                    <ProgressBar x:Name="CpuProgress" Minimum="0" Maximum="100" Value="0" />
                </StackPanel>
                <Border Grid.Column="1" Background="#344056" Margin="0,2,0,5" />
                <StackPanel x:Name="TemperaturePanel" Grid.Column="2" Margin="15,1,0,0">
                    <TextBlock Text="CPU 温度" FontSize="11" Foreground="#FF6B6B" />
                    <TextBlock x:Name="TemperatureText" Text="--°C" Style="{StaticResource MetricValue}" />
                    <TextBlock x:Name="TemperatureHint" Text="正在读取传感器" FontSize="9.5"
                               Foreground="#78859A" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Height="1" Background="#2D384B" VerticalAlignment="Center" />

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="DownloadPanel" Margin="0,4,15,0">
                    <TextBlock Text="↓ 下载" FontSize="11" Foreground="#74B9FF" />
                    <TextBlock x:Name="DownloadText" Text="0 B/s" Style="{StaticResource MetricValue}" />
                </StackPanel>
                <Border Grid.Column="1" Background="#344056" Margin="0,5,0,3" />
                <StackPanel x:Name="UploadPanel" Grid.Column="2" Margin="15,4,0,0">
                    <TextBlock Text="↑ 上传" FontSize="11" Foreground="#FFB86C" />
                    <TextBlock x:Name="UploadText" Text="0 B/s" Style="{StaticResource MetricValue}" />
                </StackPanel>
            </Grid>

            <Border x:Name="ChartSeparator" Grid.Row="4" Height="1"
                    Background="#2D384B" VerticalAlignment="Center" />

            <Grid x:Name="ChartPanel" Grid.Row="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="25" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ChartTitleText" Text="实时网速 · 最近 1 分钟"
                                   FontSize="10.5" Foreground="#8E9AAE" />
                        <Ellipse Width="6" Height="6" Fill="#74B9FF" Margin="12,4,4,0" VerticalAlignment="Top" />
                        <TextBlock Text="下载" FontSize="9.5" Foreground="#74B9FF" />
                        <Ellipse Width="6" Height="6" Fill="#FFB86C" Margin="9,4,4,0" VerticalAlignment="Top" />
                        <TextBlock Text="上传" FontSize="9.5" Foreground="#FFB86C" />
                    </StackPanel>
                    <TextBlock x:Name="NetworkScaleText" HorizontalAlignment="Right" FontSize="9.5"
                               Foreground="#69768B" Text="网络峰值 --" />
                </Grid>
                <Border Grid.Row="1" CornerRadius="6" Background="#1C2636" ClipToBounds="True">
                    <Grid>
                        <Grid Opacity="0.48">
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="1" BorderBrush="#344056" BorderThickness="0,1,0,0" />
                            <Border Grid.Row="2" BorderBrush="#344056" BorderThickness="0,1,0,0" />
                            <Border Grid.Row="3" BorderBrush="#344056" BorderThickness="0,1,0,0" />
                        </Grid>
                        <Canvas x:Name="ChartCanvas" ClipToBounds="True" SizeChanged="ChartCanvas_SizeChanged">
                            <Polyline x:Name="DownloadLine" Stroke="#74B9FF" StrokeThickness="1.8" />
                            <Polyline x:Name="UploadLine" Stroke="#FFB86C" StrokeThickness="1.8" />
                        </Canvas>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>

    <Grid x:Name="CompactPanel" Width="50" Height="228" Visibility="Collapsed"
          MouseLeftButtonDown="CompactPanel_MouseLeftButtonDown"
          MouseLeftButtonUp="CompactPanel_MouseLeftButtonUp"
          MouseMove="CompactPanel_MouseMove"
          MouseRightButtonUp="CompactPanel_MouseRightButtonUp">
        <Border CornerRadius="17" BorderBrush="#46536A" BorderThickness="1"
                SnapsToDevicePixels="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#172234" Offset="0" />
                    <GradientStop Color="#0D1420" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Grid Margin="3,10,3,10" IsHitTestVisible="False" TextOptions.TextFormattingMode="Display">
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="5" />
                <RowDefinition Height="39" />
                <RowDefinition Height="5" />
                <RowDefinition Height="1" />
                <RowDefinition Height="5" />
                <RowDefinition Height="46" />
                <RowDefinition Height="5" />
                <RowDefinition Height="46" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Width="44" Height="44" VerticalAlignment="Center">
                <Ellipse Width="40" Height="40" Stroke="#29374A" StrokeThickness="3.2" />
                <Path x:Name="CompactCpuArc" Width="44" Height="44" Stroke="#54D6A7"
                      StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="CPU" FontSize="6" Foreground="#8795AA" HorizontalAlignment="Center" />
                    <TextBlock x:Name="CompactCpuText" Text="--%" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="White" HorizontalAlignment="Center" Margin="0,-1,0,0" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" CornerRadius="7" Background="#192638" BorderBrush="#293A50"
                    BorderThickness="0.6" Padding="1">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="温度" FontSize="7" Foreground="#9AA8BC" HorizontalAlignment="Center" />
                    <TextBlock x:Name="CompactTemperatureText" Text="--°" FontSize="12"
                               Foreground="#FF9A9A" FontWeight="SemiBold" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <Border Grid.Row="4" Background="#2D384B" />

            <Border Grid.Row="6" CornerRadius="7" Background="#14263A" BorderBrush="#25415D"
                    BorderThickness="0.6" Padding="1">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="↓ 下载" FontSize="7" Foreground="#74B9FF" HorizontalAlignment="Center" />
                    <TextBlock x:Name="CompactDownloadText" Text="0 B" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="#D9EEFF" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <Border Grid.Row="8" CornerRadius="7" Background="#2B2218" BorderBrush="#584025"
                    BorderThickness="0.6" Padding="1">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="↑ 上传" FontSize="7" Foreground="#FFB86C" HorizontalAlignment="Center" />
                    <TextBlock x:Name="CompactUploadText" Text="0 B" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="#FFE6C7" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>

    </Grid>
</Window>
