<Window x:Class="CpuNetWidget.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CPU 网速悬浮窗设置"
        Width="500" Height="610"
        MinWidth="460" MinHeight="570"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="#F4F6FA"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="Padding" Value="14,10,14,14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Margin" Value="0,7,22,7" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="设置" FontSize="24" FontWeight="SemiBold" Foreground="#111827" />
            <TextBlock Text="监控项目、温度来源和启动方式" Margin="0,4,0,0" Foreground="#6B7280" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="监控项目">
                    <UniformGrid Columns="2">
                        <CheckBox x:Name="MonitorCpuCheckBox" Content="CPU 使用率" />
                        <CheckBox x:Name="MonitorTemperatureCheckBox" Content="CPU 温度"
                                  Checked="TemperatureMonitoring_Changed" Unchecked="TemperatureMonitoring_Changed" />
                        <CheckBox x:Name="MonitorDownloadCheckBox" Content="下载速率" />
                        <CheckBox x:Name="MonitorUploadCheckBox" Content="上传速率" />
                    </UniformGrid>
                </GroupBox>

                <GroupBox Header="温度读取">
                    <StackPanel>
                        <TextBlock Text="温度传感器" Foreground="#374151" Margin="0,0,0,6" />
                        <ComboBox x:Name="TemperatureSensorComboBox" Height="34"
                                  DisplayMemberPath="DisplayName" SelectedValuePath="Id" />
                        <TextBlock Margin="0,8,0,0" FontSize="11" Foreground="#6B7280"
                                   TextWrapping="Wrap"
                                   Text="建议使用“自动选择”：优先读取 CPU Package 等硬件传感器，无数据时回退到 Windows ACPI 温区。也可以手动选择以修正异常读数。" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="权限">
                    <StackPanel>
                        <CheckBox x:Name="AdministratorCheckBox" Content="启动时请求管理员权限（提高硬件温度读取兼容性）" />
                        <TextBlock x:Name="PrivilegeStatusText" FontSize="12" Foreground="#4B5563" />
                        <TextBlock Margin="0,7,0,0" FontSize="11" Foreground="#6B7280"
                                   TextWrapping="Wrap"
                                   Text="启用后，下次启动会显示标准 Windows UAC 确认。关闭后不会请求高权限。管理员权限只用于硬件传感器访问，不会关闭或绕过 UAC。" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="窗口与启动">
                    <StackPanel>
                        <CheckBox x:Name="TopmostCheckBox" Content="悬浮窗始终置顶" />
                        <CheckBox x:Name="AutoStartCheckBox" Content="登录 Windows 后自动启动" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Width="88" Height="34" Margin="0,0,10,0" IsCancel="True" />
            <Button Content="保存" Width="96" Height="34" IsDefault="True"
                    Background="#2563EB" Foreground="White" BorderThickness="0"
                    Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
