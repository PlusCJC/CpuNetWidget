<Window x:Class="CpuNetWidget.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CPU 网速悬浮窗设置"
        Width="520" Height="660"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="Foreground" Value="#F5F7FA" />
        </Style>

        <Style x:Key="TitleButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="#FF9A9A" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" CornerRadius="7" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#603B2631" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#80552B38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="Padding" Value="16,12,16,14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ContentPresenter ContentSource="Header" Margin="4,0,0,8"
                                              TextElement.FontFamily="Microsoft YaHei UI"
                                              TextElement.FontSize="12"
                                              TextElement.FontWeight="SemiBold"
                                              TextElement.Foreground="#9CA9BC" />
                            <Border Grid.Row="1" Background="#B3182333" BorderBrush="#344056"
                                    BorderThickness="1" CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="Foreground" Value="#E6EBF3" />
            <Setter Property="Margin" Value="0,7,18,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="Foreground" Value="#F5F7FA" />
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="#46536A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,4" />
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="Padding" Value="9,7" />
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Width" Value="92" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Foreground" Value="#DCE4EF" />
            <Setter Property="Background" Value="#273449" />
            <Setter Property="BorderBrush" Value="#46536A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.68" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Width" Value="104" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="BorderBrush" Value="#3B82F6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Border CornerRadius="17" Background="#F2111827" BorderBrush="#46536A" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="5" Opacity="0.5" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="62" />
                <RowDefinition Height="*" />
                <RowDefinition Height="68" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="22,13,16,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="10" Background="#273A3C" Margin="0,0,12,0">
                        <TextBlock Text="⚙" FontSize="18" Foreground="#54D6A7"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="设置" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="监控项目、曲线、温度与启动方式" FontSize="10.5" Foreground="#8190A6" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Content="×" Style="{StaticResource TitleButton}"
                        ToolTip="关闭设置" Click="CloseButton_Click" />
            </Grid>

            <ScrollViewer Grid.Row="1" Margin="22,4,17,0" Padding="0,0,5,0"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <GroupBox Header="监控项目">
                        <UniformGrid Columns="2">
                            <CheckBox x:Name="MonitorCpuCheckBox" Content="CPU 使用率" />
                            <CheckBox x:Name="MonitorTemperatureCheckBox" Content="CPU 温度"
                                      Checked="TemperatureMonitoring_Changed" Unchecked="TemperatureMonitoring_Changed" />
                            <CheckBox x:Name="MonitorDownloadCheckBox" Content="下载速率" />
                            <CheckBox x:Name="MonitorUploadCheckBox" Content="上传速率" />
                        </UniformGrid>
                    </GroupBox>

                    <GroupBox Header="实时曲线">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="曲线时间范围" Foreground="#E6EBF3" />
                                <TextBlock Text="每秒采样一次" FontSize="10.5" Foreground="#78869A" Margin="0,3,0,0" />
                            </StackPanel>
                            <ComboBox x:Name="ChartRangeComboBox" Grid.Column="1" Height="34"
                                      DisplayMemberPath="DisplayName" SelectedValuePath="Minutes" />
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="温度读取">
                        <StackPanel>
                            <TextBlock Text="温度传感器" Foreground="#E6EBF3" Margin="0,0,0,7" />
                            <ComboBox x:Name="TemperatureSensorComboBox" Height="36"
                                      DisplayMemberPath="DisplayName" SelectedValuePath="Id" />
                            <TextBlock Margin="0,9,0,0" FontSize="10.5" Foreground="#78869A"
                                       TextWrapping="Wrap"
                                       Text="自动模式优先读取 CPU Package，无数据时回退到 Windows ACPI；也可以手动指定传感器。" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="权限">
                        <StackPanel>
                            <CheckBox x:Name="AdministratorCheckBox"
                                      Content="启动时请求管理员权限（提高温度读取兼容性）" />
                            <TextBlock x:Name="PrivilegeStatusText" FontSize="11.5" Foreground="#9AA8BC" />
                            <TextBlock Margin="0,7,0,0" FontSize="10.5" Foreground="#78869A"
                                       TextWrapping="Wrap"
                                       Text="启用后，下次启动将显示标准 Windows UAC 确认；关闭后不会请求高权限。" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="窗口与启动">
                        <StackPanel>
                            <CheckBox x:Name="TopmostCheckBox" Content="悬浮窗始终置顶" />
                            <CheckBox x:Name="AutoStartCheckBox" Content="登录 Windows 后自动启动" />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="#2D384B" BorderThickness="0,1,0,0" Padding="20,15">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,10,0" IsCancel="True" />
                    <Button Content="保存设置" Style="{StaticResource PrimaryButton}"
                            IsDefault="True" Click="SaveButton_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
